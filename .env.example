# Contact form (server/api/contact.post.ts) — Gmail SMTP.
# 1. Turn on 2-Step Verification for the Google account.
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Copy this file to `.env` (local) or set the same variables on the server.
# Without NUXT_SMTP_USER/PASS, `nuxt dev` logs messages to the console instead of sending.
NUXT_SMTP_HOST=smtp.gmail.com
NUXT_SMTP_PORT=465
NUXT_SMTP_USER=you@gmail.com
NUXT_SMTP_PASS=your-16-char-app-password
# Where messages go; defaults to NUXT_SMTP_USER.
NUXT_CONTACT_TO=
