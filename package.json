{
    "name": "triplem-dev",
    "type": "module",
    "private": true,
    "version": "0.1.0",
    "packageManager": "pnpm@12.6.0",
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^22.21.1",
            "onFail": "warn"
        }
    },
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "lint": "eslint . --cache",
        "lint:fix": "eslint . --cache --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "nuxt typecheck",
        "covers": "node scripts/blog-cover.mjs build --all",
        "covers:check": "node scripts/blog-cover.mjs check --all",
        "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm covers:check"
    },
    "dependencies": {
        "@lucide/vue": "^1.48.0",
        "@nuxt/content": "3.16.1",
        "@nuxt/eslint": "1.17.0",
        "@nuxt/fonts": "0.14.0",
        "@nuxt/hints": "1.1.4",
        "@nuxt/icon": "2.5.1",
        "@nuxt/image": "^2.1.0",
        "@nuxtjs/i18n": "10.6.0",
        "@tailwindcss/vite": "^4.3.3",
        "@tresjs/cientos": "^5.9.0",
        "@tresjs/nuxt": "^5.7.0",
        "@tresjs/post-processing": "^3.8.0",
        "better-sqlite3": "^13.0.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "eslint": "^9.0.0 || ^10.0.0",
        "motion-v": "^2.4.4",
        "nodemailer": "^10.0.12",
        "nuxt": "^4.5.2",
        "reka-ui": "^2.10.5",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "three": "^0.186.1",
        "tw-animate-css": "^1.4.0",
        "uqr": "^0.1.3",
        "vue": "^3.5.43",
        "vue-router": "^5.3.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/nodemailer": "^8.0.2",
        "@types/three": "~0.186.0",
        "@vueuse/core": "^15.0.0",
        "@vueuse/nuxt": "^15.0.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "3.9.9",
        "shadcn-nuxt": "^2.8.2",
        "sharp": "0.35.5",
        "typescript": "^5.9.3",
        "vue-tsc": "^3.3.11"
    }
}
